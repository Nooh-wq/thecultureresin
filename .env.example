# The Culture Resin — environment
#
# Copy to .env.local and fill in. The site runs with NONE of these set: the
# gallery reads from lib/pieces.ts, and the order form falls back to a dry run
# that logs instead of saving. Everything below is needed before launch.
#
# Check your work at any point with:
#   npm run check:db
#   npm run check:email you@example.com

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# No trailing slash. Used for canonical URLs, sitemap, OG images, the password
# reset link and the admin link in the owner notification email. If this is
# wrong, reset links point at the wrong host and quietly stop working.
NEXT_PUBLIC_SITE_URL="https://thecultureresin.com"

# The footer's Email link and the contact address on /privacy. Optional: both
# fall back to amnasaqib201@gmail.com in lib/contact.ts, so the site is never
# published without a working contact route.
#
# Only set this to an address on the domain once that mailbox can actually
# RECEIVE. Verifying a domain in Resend enables sending, not receiving; a
# hello@ that nothing delivers to is worse than the personal address.
NEXT_PUBLIC_CONTACT_EMAIL=""

# There is deliberately no public WhatsApp number. Customers never message her;
# she contacts them using the number and email the order form collects. Her own
# "Reply on WhatsApp" buttons in the admin and in the owner notification email
# are built from the customer's number, not hers.

# ---------------------------------------------------------------------------
# Database — Supabase
# ---------------------------------------------------------------------------
# Both of these come from the same place. In the Supabase dashboard press
# Connect at the top, then the ORMs tab, then choose Prisma. It prints exactly
# these two variables for your project. Copy them rather than assembling them
# by hand: the region prefix differs between projects (aws-0, aws-1) and the
# pooler username is postgres.<project-ref>, not postgres.
#
# If the database password contains @ : / ? # or &, it has to be percent
# encoded or the URL will not parse. Easiest to reset it to something
# alphanumeric in Settings > Database.

# The transaction pooler, port 6543. This is what the app uses at runtime.
# pgbouncer=true stops Prisma using prepared statements, which transaction
# pooling cannot support. connection_limit=1 is correct for serverless: each
# function instance needs exactly one, and anything higher exhausts the pool.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# The session pooler, port 5432. Used ONLY by prisma migrate, prisma db seed
# and the scripts in package.json. Migrations take advisory locks and run DDL
# in long transactions, and neither survives the transaction pooler.
#
# Note this is pooler.supabase.com on 5432, not db.PROJECT_REF.supabase.co.
# The latter is the true direct connection and is IPv6 only on new projects,
# so it fails from most home networks and from GitHub Actions.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth — email and password, owner only
# ---------------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""

# Comma separated. ONLY these addresses can sign in to /admin. An address that
# is not on this list is rejected even if it has a valid password and a real
# user row. Creating the row is not what grants access.
ADMIN_EMAILS="amnasaqib201@gmail.com"

# Create or update the owner account, printing a generated password once:
#   npm run set-password amnasaqib201@gmail.com

# ---------------------------------------------------------------------------
# Email — Resend
# ---------------------------------------------------------------------------
# resend.com/api-keys. Sending permission is enough.
RESEND_API_KEY=""

# MUST be an address on a domain verified at resend.com/domains.
#
# Leave it empty and the site falls back to onboarding@resend.dev, which needs
# no DNS and is useful for testing, but Resend will ONLY deliver it to the
# address that owns the Resend account. Every other recipient is rejected, so
# real customers would receive nothing. npm run check:email says which mode you
# are in.
#
# Verifying a domain means adding the DKIM and SPF records Resend gives you.
# Add DMARC too, or Gmail files a new sender straight into spam.
EMAIL_FROM="The Culture Resin <orders@thecultureresin.com>"

# Where the new-order notification goes. Falls back to this same address in
# code if unset, so a missing variable cannot stop her hearing about an order.
OWNER_EMAIL="amnasaqib201@gmail.com"

# ---------------------------------------------------------------------------
# Images — Cloudinary
# ---------------------------------------------------------------------------
# Customer uploads go browser-to-Cloudinary directly, because a Vercel function
# caps request bodies at 4.5MB and the form advertises 10MB.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Rate limiting — Upstash
# ---------------------------------------------------------------------------
# Optional in development: without these the limiter is in-memory, which resets
# on every deploy and does not work across instances. Set before launch.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
