{
  "name": "the-culture-resin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/prisma.ts migrate dev",
    "db:deploy": "tsx scripts/prisma.ts migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "tsx scripts/prisma.ts studio",
    "set-password": "tsx prisma/set-password.ts",
    "check:db": "tsx scripts/check-db.ts",
    "check:email": "tsx --tsconfig tsconfig.scripts.json scripts/check-email.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.1",
    "cloudinary": "^2.10.0",
    "lenis": "^1.3.25",
    "motion": "^12.43.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.84.0",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.5",
    "typescript": "^5.9.0"
  }
}
